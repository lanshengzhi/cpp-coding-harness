{
  "version": 6,
  "cmakeMinimumRequired": { "major": 4, "minor": 0, "patch": 0 },
  "configurePresets": [
    {
      "name": "vcpkg",
      "displayName": "Default (vcpkg)",
      "description": "Build with vcpkg manifest mode for self-contained dependency resolution",
      "binaryDir": "${sourceDir}/build",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "vcpkg-release",
      "displayName": "Release (vcpkg)",
      "description": "Release build with vcpkg",
      "inherits": "vcpkg",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "dev-fast",
      "displayName": "Fast development (Ninja + ccache, Debug)",
      "description": "Optional local Debug preset: Ninja with ccache required. ADR 0039 defines supported build policy; docs/build-performance-plan.md preserves historical measurements only.",
      "inherits": "vcpkg",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/dev-fast",
      "cacheVariables": {
        "CMAKE_C_COMPILER_LAUNCHER": "ccache",
        "CMAKE_CXX_COMPILER_LAUNCHER": "ccache",
        "CMAKE_PROJECT_INCLUDE": "${sourceDir}/cmake/require-ccache.cmake"
      }
    },
    {
      "name": "dev-fast-release",
      "displayName": "Fast development release (Ninja + ccache, Release)",
      "description": "Release form of the fast-development preset: Ninja generator with ccache required and enabled.",
      "inherits": "dev-fast",
      "binaryDir": "${sourceDir}/build/dev-fast-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "vcpkg",
      "configurePreset": "vcpkg",
      "configuration": "Debug",
      "jobs": 4
    },
    {
      "name": "vcpkg-release",
      "configurePreset": "vcpkg-release",
      "configuration": "Release",
      "jobs": 4
    },
    {
      "name": "dev-fast",
      "configurePreset": "dev-fast",
      "configuration": "Debug",
      "jobs": 4
    },
    {
      "name": "dev-fast-release",
      "configurePreset": "dev-fast-release",
      "configuration": "Release",
      "jobs": 4
    }
  ],
  "testPresets": [
    {
      "name": "vcpkg",
      "configurePreset": "vcpkg",
      "configuration": "Debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "vcpkg-release",
      "configurePreset": "vcpkg-release",
      "configuration": "Release",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "dev-fast",
      "configurePreset": "dev-fast",
      "configuration": "Debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "dev-fast-release",
      "configurePreset": "dev-fast-release",
      "configuration": "Release",
      "output": { "outputOnFailure": true }
    }
  ]
}
