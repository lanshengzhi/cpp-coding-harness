{
  "version": 6,
  "cmakeMinimumRequired": { "major": 4, "minor": 4, "patch": 0 },
  "configurePresets": [
    {
      "name": "vcpkg",
      "displayName": "Default (vcpkg)",
      "description": "Supported GCC 16.x Debug build with pinned vcpkg dependencies",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "g++",
        "CCH_TOOLCHAIN_ROLE": "build",
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": true,
        "VCPKG_HOST_TRIPLET": "x64-linux",
        "VCPKG_MANIFEST_INSTALL": true,
        "VCPKG_MANIFEST_MODE": true,
        "VCPKG_TARGET_TRIPLET": "x64-linux"
      }
    },
    {
      "name": "vcpkg-release",
      "displayName": "Release (vcpkg)",
      "description": "Supported GCC 16.x Release build with pinned vcpkg dependencies",
      "inherits": "vcpkg",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "vcpkg-release-artifact",
      "displayName": "Release artifact (vcpkg, IPO/LTO)",
      "description": "Supported GCC 16.x Release IPO/LTO artifact build (issue #474): the release-qualification lane; tests are off because the supported test matrix covers them",
      "inherits": "vcpkg-release",
      "binaryDir": "${sourceDir}/build/release-artifact",
      "cacheVariables": {
        "CMAKE_INTERPROCEDURAL_OPTIMIZATION": true,
        "CCH_BUILD_TESTS": false
      }
    },
    {
      "name": "clang-conformance",
      "displayName": "Clang 22.x conformance (vcpkg)",
      "description": "Blocking Clang 22.x Debug conformance build; never a release-artifact build",
      "inherits": "vcpkg",
      "binaryDir": "${sourceDir}/build/clang-conformance",
      "cacheVariables": {
        "CCH_TOOLCHAIN_ROLE": "conformance",
        "CMAKE_CXX_COMPILER": "clang++-22"
      }
    },
    {
      "name": "vcpkg-asan-ubsan",
      "displayName": "ASan+UBSan (vcpkg)",
      "description": "Blocking GCC 16.x Debug build with AddressSanitizer and UndefinedBehaviorSanitizer coverage of the supported test suite (#473)",
      "inherits": "vcpkg",
      "binaryDir": "${sourceDir}/build/asan-ubsan",
      "cacheVariables": {
        "CCH_SANITIZER": "address;undefined"
      }
    },
    {
      "name": "vcpkg-tsan",
      "displayName": "TSan (vcpkg)",
      "description": "Blocking GCC 16.x Debug build with ThreadSanitizer for the focused asynchronous lifecycle scenarios (#473)",
      "inherits": "vcpkg",
      "binaryDir": "${sourceDir}/build/tsan",
      "cacheVariables": {
        "CCH_SANITIZER": "thread"
      }
    },
    {
      "name": "dev-fast",
      "displayName": "Fast development (Ninja + ccache, Debug)",
      "description": "Optional local Debug preset: Ninja with ccache required. ADR 0039 defines supported build policy; docs/build-performance-plan.md preserves historical measurements only.",
      "inherits": "vcpkg",
      "binaryDir": "${sourceDir}/build/dev-fast",
      "cacheVariables": {
        "CMAKE_C_COMPILER_LAUNCHER": "ccache",
        "CMAKE_CXX_COMPILER_LAUNCHER": "ccache",
        "CMAKE_PROJECT_INCLUDE": "${sourceDir}/cmake/require-ccache.cmake"
      }
    },
    {
      "name": "dev-fast-release",
      "displayName": "Fast development release (Ninja + ccache, Release)",
      "description": "Release form of the fast-development preset: Ninja generator with ccache required and enabled.",
      "inherits": "dev-fast",
      "binaryDir": "${sourceDir}/build/dev-fast-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "vcpkg",
      "configurePreset": "vcpkg",
      "configuration": "Debug",
      "jobs": 4
    },
    {
      "name": "vcpkg-release",
      "configurePreset": "vcpkg-release",
      "configuration": "Release",
      "jobs": 4
    },
    {
      "name": "vcpkg-release-artifact",
      "configurePreset": "vcpkg-release-artifact",
      "configuration": "Release",
      "jobs": 4
    },
    {
      "name": "clang-conformance",
      "configurePreset": "clang-conformance",
      "configuration": "Debug",
      "jobs": 4
    },
    {
      "name": "vcpkg-asan-ubsan",
      "configurePreset": "vcpkg-asan-ubsan",
      "configuration": "Debug",
      "jobs": 4
    },
    {
      "name": "vcpkg-tsan",
      "configurePreset": "vcpkg-tsan",
      "configuration": "Debug",
      "jobs": 4
    },
    {
      "name": "dev-fast",
      "configurePreset": "dev-fast",
      "configuration": "Debug",
      "jobs": 4
    },
    {
      "name": "dev-fast-release",
      "configurePreset": "dev-fast-release",
      "configuration": "Release",
      "jobs": 4
    }
  ],
  "testPresets": [
    {
      "name": "vcpkg",
      "configurePreset": "vcpkg",
      "configuration": "Debug",
      "output": { "outputOnFailure": true },
      "execution": { "jobs": 4, "noTestsAction": "error" }
    },
    {
      "name": "vcpkg-release",
      "configurePreset": "vcpkg-release",
      "configuration": "Release",
      "output": { "outputOnFailure": true },
      "execution": { "jobs": 4, "noTestsAction": "error" }
    },
    {
      "name": "clang-conformance",
      "configurePreset": "clang-conformance",
      "configuration": "Debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "vcpkg-asan-ubsan",
      "configurePreset": "vcpkg-asan-ubsan",
      "configuration": "Debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "vcpkg-tsan",
      "configurePreset": "vcpkg-tsan",
      "configuration": "Debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "dev-fast",
      "configurePreset": "dev-fast",
      "configuration": "Debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "dev-fast-release",
      "configurePreset": "dev-fast-release",
      "configuration": "Release",
      "output": { "outputOnFailure": true }
    }
  ]
}
