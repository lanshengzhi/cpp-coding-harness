{
  "schema_version": 3,
  "architecture_contract": {
    "schema_version": 1,
    "name": "Product Architecture Contract",
    "rules": [
      {
        "id": "headless-no-frontend-dependencies",
        "source_prefixes": [
          "src/agent/",
          "src/coding_agent/"
        ],
        "excluded_source_prefixes": [
          "src/coding_agent/tui/",
          "src/coding_agent/cli/"
        ],
        "forbidden_include_prefixes": [
          "cch/tui/",
          "coding_agent/tui/",
          "tui/",
          "src/tui/",
          "coding_agent/cli/",
          "cli/",
          "src/cli/"
        ]
      },
      {
        "id": "no-agent-private-reach-through",
        "source_prefixes": [
          "src/coding_agent/",
          "src/cli/"
        ],
        "excluded_source_prefixes": [],
        "forbidden_include_prefixes": [
          "agent/harness/OutputLimiter.hpp",
          "agent/harness/compaction",
          "agent/harness/session/EntrySerializer.hpp",
          "agent/harness/session/SessionJournal.hpp"
        ]
      },
      {
        "id": "agent-no-ai-private-includes",
        "source_prefixes": [
          "src/agent/"
        ],
        "excluded_source_prefixes": [],
        "forbidden_include_prefixes": [
          "ai/",
          "src/ai/"
        ]
      },
      {
        "id": "coding-agent-no-ai-private-includes",
        "source_prefixes": [
          "src/coding_agent/"
        ],
        "excluded_source_prefixes": [],
        "forbidden_include_prefixes": [
          "ai/",
          "src/ai/"
        ]
      },
      {
        "id": "extension-tool-source-no-agent-execution-reach-through",
        "source_prefixes": [
          "src/coding_agent/extensions/"
        ],
        "excluded_source_prefixes": [],
        "forbidden_include_prefixes": [
          "cch/agent/ToolCallExecutor.hpp",
          "agent/ToolCallExecutor.hpp",
          "cch/agent/Agent.hpp",
          "agent/Agent.hpp"
        ]
      }
    ],
    "exceptions": [
      {
        "id": "mcp-http-stream-transport-reach-through",
        "rule_id": "coding-agent-no-ai-private-includes",
        "source": "src/coding_agent/mcp/McpHttpClient.hpp",
        "owner": "cch_coding_agent",
        "removal_ticket": "#881",
        "expires": "2027-06-30",
        "reason": "Spec #865 mandated reusing ai::providers::StreamTransport for the MCP streamable-http transport; promoting the ai outbound transport to a narrow Owner Interface is the recorded upgrade (#881)."
      },
      {
        "id": "mcp-http-sse-parser-reach-through",
        "rule_id": "coding-agent-no-ai-private-includes",
        "source": "src/coding_agent/mcp/McpHttpClient.cpp",
        "owner": "cch_coding_agent",
        "removal_ticket": "#881",
        "expires": "2027-06-30",
        "reason": "Spec #865 mandated reusing ai::providers::SseParser for MCP event-stream responses; promoting the ai SSE parser to a narrow Owner Interface is the recorded upgrade (#881)."
      },
      {
        "id": "mcp-boost-beast-transport-reach-through",
        "rule_id": "coding-agent-no-ai-private-includes",
        "source": "src/coding_agent/mcp/McpExtensionToolSource.cpp",
        "owner": "cch_coding_agent",
        "removal_ticket": "#881",
        "expires": "2027-06-30",
        "reason": "Spec #865 mandated reusing ai::providers::BoostBeastStreamTransport for the production MCP HTTP transport; promoting it to a narrow Owner Interface is the recorded upgrade (#881)."
      },
      {
        "id": "mcp-oauth-flow-reach-through",
        "rule_id": "coding-agent-no-ai-private-includes",
        "source": "src/coding_agent/mcp/McpOAuthFlow.cpp",
        "owner": "cch_coding_agent",
        "removal_ticket": "#881",
        "expires": "2027-06-30",
        "reason": "Spec #882 mandated reusing the shared ai OAuth seam (OAuthHttpClient for the registration and token requests, Pkce for PKCE S256 and the callback id, JsonAccess for the token and registration bodies), so MCP OAuth speaks the same HTTPS client as the built-in credential flows; promoting a narrow ai OAuth interface is the recorded upgrade (#881)."
      },
      {
        "id": "mcp-oauth-discovery-reach-through",
        "rule_id": "coding-agent-no-ai-private-includes",
        "source": "src/coding_agent/mcp/McpOAuthDiscovery.cpp",
        "owner": "cch_coding_agent",
        "removal_ticket": "#881",
        "expires": "2027-06-30",
        "reason": "Spec #882 mandated reusing the shared ai OAuth seam (OAuthHttpClient, JsonAccess) for RFC 9728 / RFC 8414 metadata discovery, so MCP OAuth speaks the same HTTPS client as the built-in credential flows; promoting a narrow ai OAuth-discovery interface is the recorded upgrade (#881)."
      },
      {
        "id": "mcp-oauth-auth-helper-reach-through",
        "rule_id": "coding-agent-no-ai-private-includes",
        "source": "src/coding_agent/mcp/McpOAuthProvider.cpp",
        "owner": "cch_coding_agent",
        "removal_ticket": "#881",
        "expires": "2027-06-30",
        "reason": "Spec #865 mandated reusing the ai OAuth/auth helpers (Pkce, OAuthCallbackServer, OAuthHttpClient, OAuthShared, JsonAccess) so MCP OAuth shares the built-in credential flow; promoting a narrow ai auth interface is the recorded upgrade (#881)."
      }
    ]
  },
  "exception_policy": {
    "schema_version": 1,
    "required_compile_flags": ["-fno-exceptions"],
    "forbidden_compile_flags": ["-fexceptions"],
    "allowed_exception_ptr_sources": [
      "src/ai/ModelStreamBridge.hpp",
      "src/support/AsyncResultBridge.hpp"
    ],
    "forbidden_exception_calls": ["std::rethrow_exception"]
  },
  "owners": {
    "cch_ai": {
      "role": "owner",
      "root": "src/ai",
      "interface_root": "src/ai/include/cch/ai",
      "legal_owner_dependencies": []
    },
    "cch_agent_core": {
      "role": "owner",
      "root": "src/agent",
      "interface_root": "src/agent/include/cch/agent",
      "legal_owner_dependencies": ["cch_ai"]
    },
    "cch_tui": {
      "role": "owner",
      "root": "src/tui",
      "interface_root": "src/tui/include/cch/tui",
      "legal_owner_dependencies": []
    },
    "cch_coding_agent": {
      "role": "owner",
      "root": "src/coding_agent",
      "interface_root": "src/coding_agent/include/cch/coding_agent",
      "legal_owner_dependencies": ["cch_agent_core", "cch_ai"],
      "implementation_owner_dependencies": ["cch_tui"]
    },
    "cch_support": {
      "role": "support",
      "root": "src/support",
      "interface_root": "src/support/include/cch/support",
      "legal_owner_dependencies": []
    }
  },
  "roles": ["owner", "implementation", "support", "composition", "external"],
  "external_families": {
    "boost": { "description": "Boost libraries" },
    "openssl": { "description": "OpenSSL crypto and TLS" },
    "glaze": { "description": "Glaze JSON serialization" },
    "md4c": { "description": "md4c Markdown parsing" },
    "webp": { "description": "libwebp image decoding" },
    "wasmedge": { "description": "WasmEdge WebAssembly runtime (codemode sandbox)" },
    "utf8proc": { "description": "utf8proc Unicode processing" },
    "threads": { "description": "POSIX threads (pthread) system library" },
    "catch2": { "description": "Catch2 test framework" }
  },
  "evidence": [
    {
      "id": "ownership-index",
      "producer": "cch-parity-constructor",
      "producer_schema_version": 1,
      "input_identities": ["manifest"]
    },
    {
      "id": "direct-includes",
      "producer": "cch-parity-lexer",
      "producer_schema_version": 2,
      "input_identities": ["manifest", "ownership-index"]
    },
    {
      "id": "compile-commands",
      "producer": "cmake-file-api",
      "producer_schema_version": 1,
      "input_identities": ["manifest", "ownership-index"]
    },
    {
      "id": "depfiles",
      "producer": "cch-compiler-depfile",
      "producer_schema_version": 2,
      "input_identities": ["manifest", "ownership-index", "compile-commands"]
    }
  ]
}
