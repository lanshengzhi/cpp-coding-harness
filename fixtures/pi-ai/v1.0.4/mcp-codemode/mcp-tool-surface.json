  "toolName": {
    "pattern": "mcp__<server>__<tool>",
    "sanitization": "every character outside [A-Za-z0-9_] becomes _",
    "maxLength": 64,
    "examples": [
      {
        "server": "filesystem",
        "tool": "read_file",
        "name": "mcp__filesystem__read_file"
      },
      {
        "server": "a-b",
        "tool": "x.y",
        "name": "mcp__a_b__x_y"
      },
      {
        "server": "ssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssss",
        "tool": "tttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttt",
        "name": "mcp__ssssssssssssssssssssssssssssssssssssssssssssssssss_a1dfb0a6"
      }
    ],
    "collision": {
      "first": "mcp__srv__a_b",
      "second": "mcp__srv__a_b",
      "secondWhenTaken": "mcp__srv__a_b_5c15ffbd"
    }
  },
  "namespace": {
