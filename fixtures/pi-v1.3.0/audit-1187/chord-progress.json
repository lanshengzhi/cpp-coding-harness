  "scenarios": [
    {
      "name": "progress commits the first change at once then paces later commits by their written bytes",
      "inputs": {
        "minIntervalMs": 100,
        "writeBytes": [
          51200,
          10,
          10
        ],
        "steps": [
          {
            "mark": 1
          },
          {
            "advanceMs": 0
          },
          {
            "mark": 2
          },
          {
            "advanceMs": 499
          },
          {
            "advanceMs": 1
          },
          {
            "mark": 1
          },
          {
            "advanceMs": 99
          },
          {
            "advanceMs": 1
          }
        ]
      },
      "expected": {
        "bytesPerSecond": 102400,
        "commits": [
          {
            "atMs": 0,
            "bytes": 51200
          },
          {
            "atMs": 500,
            "bytes": 10
          },
          {
            "atMs": 600,
            "bytes": 10
          }
        ]
      },
      "normalizations": [
        "the frozen Progress class runs under deterministic virtual timers, so the observation is its pacing arithmetic and never a wall-clock latency measurement",
        "commit timestamps and written byte counts are recorded exactly; no elapsed-time bound or tolerance is applied"
      ]
    },
    {
      "name": "progress keeps the exact fractional byte-rate pause instead of rounding it",
      "inputs": {
        "minIntervalMs": 0,
        "writeBytes": [
          1025,
          1
        ],
        "steps": [
          {
            "mark": 1
          },
          {
            "advanceMs": 0
          },
          {
            "mark": 1
          },
          {
            "advanceMs": 10.009765625
          }
        ]
      },
      "expected": {
        "bytesPerSecond": 102400,
        "commits": [
          {
            "atMs": 0,
            "bytes": 1025
          },
          {
            "atMs": 10.009765625,
            "bytes": 1
          }
        ]
      },
      "normalizations": [
        "the frozen Progress class runs under deterministic virtual timers, so the observation is its pacing arithmetic and never a wall-clock latency measurement",
        "commit timestamps and written byte counts are recorded exactly; no elapsed-time bound or tolerance is applied"
      ]
    }
