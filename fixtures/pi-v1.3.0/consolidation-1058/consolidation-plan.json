  "groups": [
    {
      "id": "group-tool-execution-duration",
      "title": "Tool execution duration across agent core, application Session, TUI and durable Harness",
      "rationale": "One frozen contract (monotonic execute-only durationMs) with four distinct owners/consumers; the rows stay separate because each consumer is migrated by a different owner slice, but they share one comparison family.",
      "members": [
        "cch_agent_core:ToolCallExecutor:duration",
        "cch_agent_core:NestedToolCalls:duration",
        "cch_agent_core:ToolResult:duration-field",
        "cch_coding_agent:AgentSession:tool-telemetry",
        "cch_coding_agent:TUI:tool-duration",
        "cch_coding_agent:tool-duration",
        "cch_durable:tool-execution-timing"
      ]
    },
    {
      "id": "group-native-extension-lifecycle",
      "title": "Native extension registration, hooks, wrapping and run triggering",
      "rationale": "The same selected native extension contract appears as an application Session seam (1049/1051) and as a durable Harness seam (1056). Owners and consumers differ, so rows stay separate; the group records one membership authority and one removal of the historical ADR 0066 clause.",
      "members": [
        "cch_coding_agent:extension-native-tool-source",
        "cch_coding_agent:extension-lifecycle-hooks",
        "cch_coding_agent:extension-registration-tool-source",
        "cch_coding_agent:extension-editor-lifecycle",
        "cch_coding_agent:extension-prompt-status-ui",
        "cch_coding_agent:prompt-busy-lifecycle",
        "cch_durable:native-run-triggering",
        "cch_durable:generation-onYield"
      ]
    },
    {
      "id": "group-tool-selection-loadout",
      "title": "Tool selection modifiers and resumed loadout",
      "rationale": "Application Session resume rows and product CLI/session behavior; one contract, application owner only.",
      "members": [
        "cch_coding_agent:Session:resume:tool-loadout",
        "cch_coding_agent:Session:resume:relative-tool-modifiers"
      ]
    },
    {
      "id": "group-durable-tasks-harness",
      "title": "Durable task semantics seen through tasks (1055) and Harness workflows (1056)",
      "rationale": "1055 drives the scheduler/task store through the public durable session path; 1056 drives the same contracts through Harness.open. Same owner (cch_durable), same frozen contracts, different capture lanes; the rows stay separate and cross-reference instead of duplicating or hiding evidence.",
      "members": [
        "cch_durable:task-definition-registry",
        "cch_durable:task-observed-outcomes",
        "cch_durable:task-lifecycle-hooks",
        "cch_durable:request-id-deduplication",
        "cch_durable:busy-admission-modes",
        "cch_durable:recovery-open",
        "cch_durable:registry-task-definitions",
        "cch_durable:task-versioning",
        "cch_durable:task-outcomes",
        "cch_durable:task-hooks",
        "cch_durable:submission-queues",
        "cch_durable:task-recovery"
      ]
    },
    {
      "id": "group-durable-chord-subset",
      "title": "Durable-required Chord contracts (1054 overview rows, 1057 detail rows, 1056 durable usage rows)",
      "rationale": "1054 records five coarse Chord rows the durable session depends on; 1057 records the same contracts per operation; 1056 records durable's own usage. One owner (cch_chord), one consumer (cch_durable); 1054 rows are the coarse view of 1057 detail and are kept with an explicit overlap resolution rather than deleted.",
      "members": [
        "cch_chord:Chord:context",
        "cch_chord:Chord:draft",
        "cch_chord:Chord:delta",
        "cch_chord:Chord:state",
        "cch_chord:Chord:json",
        "cch_chord:chord-documents",
        "cch_chord:chord-delta"
      ]
    },
    {
      "id": "group-codemode-core-and-integration",
      "title": "Codemode core contracts (1053) and durable/application integration (1053/1056)",
      "rationale": "The reusable VM/declaration/Remote contract belongs to cch_codemode; the application catalog, store, loadout and durable script integrations are consumers. Rows stay separate per owner; the group records the true contract identity behind the similar names.",
      "members": [
        "cch_codemode:codemode-worker-lifetime",
        "cch_codemode:codemode-remote-exchange",
        "cch_codemode:codemode-deterministic-start",
        "cch_durable:codemode-script",
        "cch_durable:codemode-store",
        "cch_durable:codemode-replay",
        "cch_codemode:codemode-remote",
        "cch_durable:codemode-models",
        "cch_durable:codemode-limits",
        "cch_durable:codemode-output"
      ]
    },
    {
      "id": "group-tui-toolkit-product",
      "title": "TUI toolkit exports (1050) and Native TUI product consumers (1051)",
      "rationale": "The toolkit contract belongs to cch_tui; the product TUI behavior belongs to cch_coding_agent (frontend_tui). The toolkit rows for a component and the product rows that consume it are adjacent but not the same contract; the group keeps the toolkit/product split explicit and routes the seven 1050 product-entry rows to the 1051 product evidence.",
      "members": [
        "cch_coding_agent:product.tuiMode",
        "cch_coding_agent:product.--tui-mode",
        "cch_coding_agent:product.runInteractiveMode",
        "cch_coding_agent:product.fullscreenExitOutput",
        "cch_coding_agent:product.fullscreenCopyOnSelect",
        "cch_coding_agent:product.fullscreenWheelScrollLines",
        "cch_coding_agent:product.showHardwareCursor"
      ]
    },
    {
      "id": "group-application-session-storage",
      "title": "Application Session transcript (1048) versus durable Session/storage (1054)",
      "rationale": "Two distinct runtimes with different storage formats and consumers. ADR 0075 keeps the ordinary application Session separate from durable; no row merges and no consumer may cross the boundary.",
      "members": [
        "cch_coding_agent:Session:storage:transcript-vs-durable",
        "cch_durable:Session:storage:sqlite-alternative",
        "cch_durable:Session:create"
      ]
    }
  ],
  "overlaps": [
    {
      "id": "overlap-toolkit-product",
