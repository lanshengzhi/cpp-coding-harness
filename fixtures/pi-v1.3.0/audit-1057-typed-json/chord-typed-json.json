  "scenarios": [
    {
      "name": "copyJson copies strict JSON without retaining aliases",
      "source": "packages/chord/test/json.test.ts:copies strict JSON without retaining aliases; packages/chord/src/json.ts:copyJson",
      "inputs": {
        "value": {
          "left": {
            "value": 1
          },
          "right": {
            "value": 1
          }
        },
        "sharedInput": "left and right name one object"
      },
      "expected": {
        "copiedBeforeMutation": {
          "left": {
            "value": 1
          },
          "right": {
            "value": 1
          }
        },
        "copiedIsInput": false,
        "leftIsShared": false,
        "rightIsShared": false,
        "leftIsRight": false,
        "sharedValueAfterCopyMutation": 1,
        "sourceAfterCopyMutation": {
          "left": {
            "value": 1
          },
          "right": {
            "value": 1
          }
        },
        "copiedAfterMutation": {
          "left": {
            "value": 2
          },
          "right": {
            "value": 1
          }
        }
      }
    },
    {
      "name": "copyJson preserves null prototypes and own __proto__ data properties",
      "source": "packages/chord/test/json.test.ts:preserves null prototypes and own __proto__ data properties; packages/chord/src/json.ts:copyJson",
      "inputs": {
        "value": {
          "__proto__": {
            "safe": true
          }
        },
        "nullPrototype": true,
        "ownProtoDataProperty": true
      },
      "expected": {
        "copiedPrototypeIsNull": true,
        "copiedHasOwnProto": true,
        "copiedProtoValue": {
          "safe": true
        },
        "copiedEqualsInputShape": true
      }
    },
    {
      "name": "copyJson rejects a non-finite number nested below the root",
      "source": "packages/chord/src/json.ts:copyJson (non-finite recursion)",
      "inputs": {
        "value": {
          "outer": {
            "inner": [
              1,
              "NaN"
            ]
          }
        }
      },
      "expected": {
        "failure": {
          "name": "TypeError",
          "message": "Value contains a non-finite number and is not strict JSON"
        }
      }
    },
    {
      "name": "isJsonValue checks strict JSON without normalizing it",
