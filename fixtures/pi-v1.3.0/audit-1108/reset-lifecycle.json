  "scenarios": [
    {
      "name": "reset retains live tools, model and thinking level and restores the message baseline",
      "inputs": {
        "initialState": {
          "systemPrompt": "sys",
          "tools": [
            "echo"
          ],
          "model": {
            "id": "reasoning-mock",
            "reasoning": true
          },
          "thinkingLevel": "high"
        },
        "prompt": "go",
        "queuedBeforeReset": [
          "steer",
          "follow"
        ],
        "promptAfterReset": "again"
      },
      "expected": {
        "beforeReset": {
          "roles": [
            "system",
            "user",
            "assistant"
          ],
          "hasQueuedMessages": true
        },
        "afterReset": {
          "roles": [
            "system"
          ],
          "systemContent": "sys",
          "systemToolsAdded": [
            "echo"
          ],
          "systemPrompt": "sys",
          "tools": [
            "echo"
          ],
          "modelId": "reasoning-mock",
          "thinkingLevel": "high",
          "hasQueuedMessages": false,
          "isStreaming": false,
          "streamingMessage": null,
          "pendingToolCalls": []
        },
        "afterResetRequest": {
          "roles": [
            "system",
            "user"
          ],
          "systemToolsAdded": [
            "echo"
          ]
        }
      },
      "normalizations": [],
      "upstreamTest": {
        "path": "packages/agent/test/agent.test.ts",
        "case": "restores the transcript baseline when reset"
      }
    },
    {
      "name": "reset during an active run is rejected without changing the run or transcript",
      "inputs": {
        "prompt": "Hello",
        "resetWhen": "assistant stream started, before its terminal"
      },
      "expected": {
        "beforeReset": {
          "isStreaming": true,
          "roles": [
            "user"
          ]
        },
        "resetError": "Agent is already processing. Wait for completion before resetting.",
        "afterRejectedReset": {
          "isStreaming": true,
          "roles": [
            "user"
          ]
        },
        "afterRun": {
          "isStreaming": false,
          "roles": [
            "user",
            "assistant"
          ],
          "lastAssistantText": "Done"
        }
      },
      "normalizations": [],
      "upstreamTest": {
        "path": "packages/agent/test/agent.test.ts",
        "case": "should reject reset while processing without corrupting the transcript"
      }
    },
