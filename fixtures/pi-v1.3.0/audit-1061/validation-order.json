          "value": 1,
          "items": [
            "a"
          ]
        },
        "ops": [
          [
            "s",
            [
              "value"
            ],
            2
          ],
          [
            "s",
            [],
            3
          ]
        ]
      },
      "expected": {
        "targetAfter": {
          "value": 2,
          "items": [
            "a"
          ]
        },
        "error": {
          "name": "TypeError",
          "message": "path is empty"
        }
      },
      "normalizations": [
        "Frozen validates each operation as the loop reaches it, so the leading set stays applied; a whole-batch pre-validation would leave `targetAfter` at `initial`."
