    {
      "name": "a later empty path keeps the preceding mutable write and reports the empty path",
      "source": "packages/chord/src/delta/index.ts:apply,applyOps,assertValidOp; packages/chord/test/delta.test.ts:rejects unknown verbs, malformed tuples, paths, and splice payloads",
      "inputs": {
