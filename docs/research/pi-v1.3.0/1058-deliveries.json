      "rows": [
        {
          "id": "cch_coding_agent:mcp-management-ui",
          "remainingBoundary": [],
          "comparisons": [
            {
              "artifact": "audit-1104/management-during-connection.json",
              "scenario": "the /mcp manager lists connecting servers and completes a sign-in while another server connects",
              "test": "/mcp panel stays live while a server connect is pending and subcommands await the settle",
              "testSource": "tests/coding_agent/tui/McpManagerFlowTest.cpp"
            }
          ],
          "discriminatingCase": {
            "test": "sign-in completes for one server while another is still connecting",
            "testSource": "tests/coding_agent/McpSessionManagerTest.cpp",
            "reason": "One server's connect is held open on a gate while the OAuth server signs in: the manager reports the gated server connecting, the panel stays interactive and the sign-in completes. A design that awaited the handshakes before publishing the snapshot, or before dispatching a subcommand, fails this case."
          }
        },
        {
          "id": "cch_coding_agent:mcp-external-signin-pickup",
          "remainingBoundary": [],
          "comparisons": [
            {
              "artifact": "audit-1104/management-during-connection.json",
              "scenario": "a sign-in performed outside the session is picked up on the next turn",
              "test": "on_turn_start reconnects a server signed in through another process",
              "testSource": "tests/coding_agent/McpSessionManagerTest.cpp"
            }
          ],
          "discriminatingCase": {
            "test": "on_turn_start leaves a needs-auth server alone when the stored tokens are unchanged",
            "testSource": "tests/coding_agent/McpSessionManagerTest.cpp",
            "reason": "The unchanged-fingerprint turn keeps the server needs-auth and reconnects zero times, while a store mutated from a second owner changes the fingerprint, reconnects exactly once and exposes the tool. An unconditional per-turn reconnect and a no-pickup design both fail this pair."
          }
        }
